<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee" version="3.0">
 <display-name>Pedidos legado</display-name>
 <listener><listener-class>br.com.exemplo.legado.LegacyWarmup</listener-class></listener>
 <servlet><servlet-name>Pedidos</servlet-name><servlet-class>br.com.exemplo.legado.PedidoServlet</servlet-class></servlet>
 <servlet-mapping><servlet-name>Pedidos</servlet-name><url-pattern>/api/pedidos</url-pattern></servlet-mapping>
 <session-config><session-timeout>30</session-timeout></session-config>
 <resource-ref><res-ref-name>jdbc/PedidosDS</res-ref-name><res-type>javax.sql.DataSource</res-type><res-auth>Container</res-auth></resource-ref>
</web-app>
