<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" version="2.1">
 <persistence-unit name="PedidosPU" transaction-type="JTA">
  <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
  <jta-data-source>jdbc/PedidosDS</jta-data-source>
  <class>br.com.exemplo.legado.Pedido</class>
  <exclude-unlisted-classes>true</exclude-unlisted-classes>
  <properties><property name="eclipselink.target-database" value="Oracle"/><property name="eclipselink.logging.level" value="INFO"/></properties>
 </persistence-unit>
</persistence>
